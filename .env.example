# ACFPF AI configuration
# Copy these values into your shell environment; this file is documentation only.

# Default and recommended free provider for development.
ACFPF_LLM_PROVIDER=groq
ACFPF_LLM_API_KEY=

# Optional. If omitted, ACFPF selects the provider's default model.
# Groq default: openai/gpt-oss-120b
# Gemini default: gemini-3.8-flash
# Mistral default: mistral-small-latest
# OpenAI default: gpt-4.1-mini
# OpenRouter default: openrouter/free
ACFPF_LLM_MODEL=

# Supported providers: groq, gemini, mistral, openai, openrouter
# Provider-specific key variables (GROQ_API_KEY, GEMINI_API_KEY, MISTRAL_API_KEY,
# OPENAI_API_KEY, OPENROUTER_API_KEY) are also accepted for backward compatibility.
